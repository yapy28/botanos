botanos:PS_potSizeMin a sh:PropertyShape ;
    sh:path botanos:potSizeMin ;
    sh:name "minimum pot size (cm)"@en ;
    sh:description "Minimum recommended pot diameter in centimeters."@en ;
    sh:datatype xsd:decimal ;
    sh:nodeKind sh:Literal ;
    dash:searchWidget core:NumberProperty ;
    sh:order "15"^^xsd:integer ;
