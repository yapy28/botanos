# Categories (SKOS concept, multi-valued)

botanos:PS_plantCategory a sh:PropertyShape ;
    sh:path botanos:plantCategory ;
    sh:name "plant category"@en ;
    sh:description "Informal grouping: tropical, succulent, fern, etc."@en ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    dash:searchWidget core:ListProperty ;
    datasources:datasource datasources:list_skospreflabel_alpha ;
    sh:order "17"^^xsd:integer ;
    sh:minCount 0 ;
    core:enableOptional "false"^^xsd:boolean ;
    core:enableNegation "false"^^xsd:boolean .

botanos:PS_toxicTo a sh:PropertyShape ;
    sh:path botanos:toxicTo ;
    sh:name "toxic to"@en ;
    sh:description "Animals that this plant is toxic to. Select Non-Toxic for pet-safe plants."@en ;
    sh:nodeKind sh:IRI ;
    sh:class skos:Concept ;
    dash:searchWidget core:ListProperty ;
    datasources:datasource datasources:list_skospreflabel_alpha ;
    sh:order "18"^^xsd:integer ;
    sh:minCount 0 ;
    core:enableOptional "false"^^xsd:boolean ;
    core:enableNegation "false"^^xsd:boolean .
