    core:enableOptional "false"^^xsd:boolean ;
    core:enableNegation "false"^^xsd:boolean .

botanos:PS_potSizeMax a sh:PropertyShape ;
    sh:path botanos:potSizeMax ;
    sh:name "maximum pot size (cm)"@en ;
