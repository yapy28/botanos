@prefix botanos: <https://w3id.org/botanos/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

botanos:ToxicityScheme a skos:ConceptScheme ;
    skos:prefLabel "Toxicity"@en ;
    dcterms:description "Animals that a plant is toxic to. NonToxic means the plant is safe for all animals."@en .

botanos:NonToxic a skos:Concept ;
    skos:prefLabel "Non-Toxic"@en ;
    skos:definition "Not toxic to any known animals. Safe for all pets."@en ;
    skos:inScheme botanos:ToxicityScheme .

botanos:Human a skos:Concept ;
    skos:prefLabel "Human"@en ;
    skos:definition "Toxic to humans."@en ;
    skos:inScheme botanos:ToxicityScheme .

